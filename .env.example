# 复制这个文件为 .env，填入自己的信息。
# .env 已被 .gitignore 忽略，不会进仓库。
# 也可以不用 .env，直接设成同名环境变量。

# ===== 必填：学习通账号 =====
CHAOXING_USER=
CHAOXING_PASSWORD=

# ===== 必填：DeepSeek API Key（https://platform.deepseek.com）=====
DEEPSEEK_API_KEY=

# ===== 必填：三个页面元素（F12 复制，见 README「怎么找那三个元素」）=====
# 下面的值都是假的示例，换成你自己页面上的
# 首页第一门课的入口，形如 #first123456
CHAOXING_COURSE_ENTRY=
# 课程块 id，形如 c_123456789
CHAOXING_COURSE_ID=
# 课程页「作业」导航，形如 #nav_123456 > a > i
CHAOXING_COURSE_NAV=

# ===== 可选 =====
# 显式等待秒数，网慢就调大
# CHAOXING_TIMEOUT=20
# 单次最多处理几份作业
# CHAOXING_MAX=20
# 1 = 无头模式（看不到浏览器，出问题时不好排查）
# CHAOXING_HEADLESS=0
# 模型与接口地址
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
